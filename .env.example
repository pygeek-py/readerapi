# Copy this file to .env and fill in real values. .env is gitignored.

SECRET_KEY=change-me-to-a-random-secret-value
DEBUG=True
ALLOWED_HOSTS=readerapi.onrender.com,localhost,127.0.0.1

# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Leave unset locally to fall back to a throwaway sqlite3 file.
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base URL of the deployed frontend (used to build links inside emails)
FRONTEND_URL=http://localhost:3000

# Email: defaults to printing emails to the console (no real send).
#
# On Render (outbound SMTP is blocked) send through the Gmail API over HTTPS:
#   EMAIL_BACKEND=api.gmail_backend.GmailAPIEmailBackend
#   GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET / GMAIL_REFRESH_TOKEN
#   DEFAULT_FROM_EMAIL=Reader <your-gmail-address@gmail.com>
# Get the three GMAIL_* values with: python scripts/gmail_authorize.py CLIENT_ID CLIENT_SECRET
# New accounts must confirm their email whenever a non-console backend is set;
# force it either way with REQUIRE_EMAIL_VERIFICATION=True/False.

# Fill these in with a real SMTP provider to actually deliver mail.
# If port 587 (TLS) is blocked on your network, use port 465 with
# EMAIL_USE_TLS=False and EMAIL_USE_SSL=True instead.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Seconds to wait on the SMTP connection before giving up (default 10).
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Reader <no-reply@reader.app>
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
